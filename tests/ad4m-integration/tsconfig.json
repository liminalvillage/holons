{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib/*": ["../../src/lib/*"]
    }
  },
  "include": ["**/*.ts", "../../src/lib/**/*.ts"]
}
