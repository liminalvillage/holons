{
	"name": "harvest-web",
	"version": "2.0.0",
	"private": true,
	"author": {
		"name": "Roberto Valenti"
	},
	"license": "AGPL",
	"keywords": [
		"holons",
		"holonic",
		"holosphere",
		"dashboard",
		"svelte",
		"typescript",
		"tailwindcss",
		"mapbox",
		"h3",
		"federation"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"deploy": "node scripts/deploy.mjs",
		"deploy:localhost": "node scripts/deploy.mjs --network localhost --all",
		"deploy:sepolia": "node scripts/deploy.mjs --network sepolia --all",
		"deploy:gnosis": "node scripts/deploy.mjs --network gnosis --all",
		"deploy:mainnet": "node scripts/deploy.mjs --network mainnet --all",
		"docs": "typedoc"
	},
	"devDependencies": {
		"@sveltejs/adapter-netlify": "^4.4.2",
		"@sveltejs/kit": "^2.4.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.1",
		"@tsconfig/svelte": "^5.0.4",
		"@types/d3": "^7.4.3",
		"@types/node": "^22.15.17",
		"@types/qrcode": "^1.5.6",
		"@typescript-eslint/eslint-plugin": "^8.32.0",
		"@typescript-eslint/parser": "^8.32.0",
		"autoprefixer": "^10.4.20",
		"clean-jsdoc-theme": "^4.3.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-svelte": "^3.5.1",
		"eslint-plugin-tailwindcss": "^3.18.0",
		"eslint-plugin-unused-imports": "^4.0.0",
		"jsdoc": "^4.0.5",
		"postcss": "^8.4.24",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte-check": "^3.0.1",
		"tailwindcss": "^3.4.16",
		"tslib": "^2.4.1",
		"tsx": "^4.7.0",
		"typedoc": "^0.28.15",
		"typescript": "^5.7.3",
		"vite": "^6.0.0",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"overrides": {
		"esbuild": "0.19.12"
	},
	"dependencies": {
		"@holons/core": "workspace:*",
		"@mapbox/mapbox-gl-geocoder": "^5.0.3",
		"@mapbox/search-js-web": "^1.0.0-beta.21",
		"@noble/curves": "^1.9.7",
		"@noble/hashes": "^1.8.0",
		"@scure/base": "^1.2.6",
		"ajv": "^8.18.0",
		"buffer": "^6.0.3",
		"d3": "^7.9.0",
		"ethers": "^6.14.0",
		"eventemitter3": "^5.0.4",
		"fontawesome": "^5.6.3",
		"gun": "^0.2020.1241",
		"h3-js": "^4.4.0",
		"holosphere": "1.3.0-alpha4",
		"html2canvas": "^1.4.1",
		"html5-qrcode": "^2.3.8",
		"ical.js": "^2.2.1",
		"jspdf": "^4.0.0",
		"jszip": "^3.10.1",
		"lune": "^0.4.0",
		"mapbox-gl": "^3.7.0",
		"qrcode": "^1.5.4",
		"sass": "^1.77.6",
		"svelte": "^5.0.0",
		"svelte-dnd-action": "^0.9.65",
		"svelte-feather-icons": "^4.2.0",
		"svelte-feathers": "^1.0.6",
		"svelte-preprocess": "^6.0.3"
	}
}
