{
  "name": "kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "Kiosk — a minimal, touch-first PWA for the hub entrance: calendar, task backlog, and library of things, auto-rotating between views.",
  "author": {
    "name": "Roberto Valenti"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5273",
    "build": "vite build",
    "preview": "vite preview --port 5273",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "prettier --check .",
    "deploy:preview": "bash ./deploy.sh",
    "deploy": "bash ./deploy.sh --prod"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "^4.4.2",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.15.17",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.0.0",
    "svelte-check": "^3.0.1",
    "tslib": "^2.4.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@holons/core": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "buffer": "^6.0.3",
    "holosphere": "workspace:*",
    "jose": "^6.2.3"
  }
}
