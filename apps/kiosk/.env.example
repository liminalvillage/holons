# Kiosk configuration (read by Vite at build/dev time).
#
# The kiosk shares the monorepo-root .env. These VITE_-prefixed vars are the
# only ones it reads; the holon and app can also be overridden per-device via
# URL query params (?holon=… / ?app=…) or the in-app Settings panel, which are
# remembered in the browser.

# The kiosk reads PRODUCTION by default — it does NOT use the shared dev
# `VITE_HOLONS_APP` (which the web/bot point at HolonsDebug). Override these
# kiosk-specific vars only if you must point an entrance display elsewhere.
#
# Holosphere app namespace. Defaults to "Holons" (production) if unset.
VITE_KIOSK_APP=Holons
# Gun relay to read from. Defaults to the production relay if unset.
VITE_KIOSK_PEER=https://gun.holons.io/gun

# Which wire the kiosk uses: gun (default) or nostr. On `nostr` the relay IS
# the wire — Gun runs peerless as the local cache and every write is published
# as a signed NIP-01 kind-30078 event, so the kiosk sees only what is on the
# relay (production data on gun.holons.io will not appear). Needs at least one
# relay below, otherwise holosphere falls back to gun.
VITE_KIOSK_BACKEND=gun
# Comma-separated wss:// relays. Falls back to the shared
# VITE_HOLOSPHERE_RELAYS when unset. Required by both modes below.
VITE_KIOSK_RELAYS=

# Signing on the GUN backend: off (default) | shadow | enforce. With relays set,
# `shadow` keeps Gun as the wire — the kiosk still sees all production data —
# while publishing every write to the relay as a signed NIP-01 event. This is
# the additive way to get signed messages on the relay; `nostr` above is the
# relay-native one. Ignored when VITE_KIOSK_BACKEND=nostr.
VITE_KIOSK_SIGNING=off

# The holon this entrance screen displays. No default — set it here, choose it
# from the in-app Settings panel, or open the kiosk once with ?holon=<id>.
VITE_KIOSK_HOLON=

# ── Editing (optional) ──────────────────────────────────────────────────────
# The kiosk is view-only until someone logs in with Telegram. To enable the
# official Telegram Login Widget, set the username (no @) of the bot that backs
# this hub. The bot's login domain must be registered as `hubs.network` via
# @BotFather's /setdomain — Telegram honours that domain and all its subdomains,
# so one /setdomain authorises every *.hubs.network kiosk. Without this, viewing
# still works; editing is unavailable.
VITE_TELEGRAM_BOT_USERNAME=

# Dev-only convenience: auto-"log in" as this Telegram user outside production
# so you can exercise editing without the widget. Ignored in production builds.
VITE_DEV_TELEGRAM_USER_ID=
VITE_DEV_TELEGRAM_USER_NAME=
VITE_DEV_TELEGRAM_USER_LAST_NAME=
VITE_DEV_TELEGRAM_USER_USERNAME=

# ── Voice (optional) ────────────────────────────────────────────────────────
# Two pipelines behind the same widget; VITE_VOICE_MODE=ws|direct picks
# explicitly, otherwise an explicit VITE_VOICE_WS_URL keeps ws, else an
# available OpenAI key enables direct. Neither → the buttons stay hidden.
#
# ws: a @holons/voice-ui server (local models or hosted APIs).
VITE_VOICE_WS_URL=
# direct: the browser calls the OpenAI API itself (Whisper STT → agent loop →
# tts-1). The key normally comes from the in-app Settings → Voice field and
# stays on that device (localStorage). This env var is a LOCAL-DEV fallback
# only — never set it on a deployed site: it would be inlined into the public
# client bundle for anyone to extract.
VITE_OPENAI_API_KEY=
VITE_VOICE_MODE=
# Optional direct-mode model overrides (defaults shown).
#VITE_VOICE_LLM_MODEL=gpt-4o-mini
#VITE_VOICE_STT_MODEL=whisper-1
#VITE_VOICE_TTS_MODEL=tts-1
#VITE_VOICE_TTS_VOICE=alloy

# ── Telegram pictures & avatars (server-side) ───────────────────────────────
# /api/image and /api/avatar resolve Telegram file_ids through the Bot API.
# BOT_TOKEN is tried first — a SERVER-ONLY secret (no VITE_ prefix, read via
# $env/dynamic/private at runtime): set it in the shared root .env locally and
# in the host's env (e.g. Netlify UI) in production; it never enters the repo
# or the client bundle. Deploys without the token proxy one hop to a peer
# deploy that has it (same /api shape). Default upstream is shown; set "off"
# to disable proxying.
BOT_TOKEN=
#IMAGE_PROXY_URL=https://dashboard.holons.io/api
