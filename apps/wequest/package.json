{
  "name": "wequest",
  "version": "0.1.0",
  "private": true,
  "description": "WeQuest — a list is a signal. Mobile-first prototype of the geolocated needs network: hex map, list-as-signal, quests, coops, hours & karma.",
  "author": {
    "name": "Roberto Valenti"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
