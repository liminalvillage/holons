# Akasha kiosk configuration (read by Vite at build/dev time).
#
# Akasha shares the monorepo-root .env. These VITE_-prefixed vars are the only
# ones it reads; both can also be overridden per-device via URL query params
# (?holon=… / ?app=…), which are remembered in the browser.

# Holosphere app namespace. Defaults to "Holons" if unset.
VITE_HOLONS_APP=Holons

# The holon this entrance screen displays. No default — set it here or open the
# kiosk once with ?holon=<id> to pin it on the device.
VITE_AKASHA_HOLON=

# ── Editing (optional) ──────────────────────────────────────────────────────
# Akasha is view-only until someone logs in with Telegram. To enable the
# official Telegram Login Widget, set the username (no @) of the bot that backs
# this hub. The bot's domain must be set to the kiosk's origin via @BotFather's
# /setdomain. Without this, viewing still works; editing is unavailable.
VITE_TELEGRAM_BOT_USERNAME=

# Dev-only convenience: auto-"log in" as this Telegram user outside production
# so you can exercise editing without the widget. Ignored in production builds.
VITE_DEV_TELEGRAM_USER_ID=
VITE_DEV_TELEGRAM_USER_NAME=
VITE_DEV_TELEGRAM_USER_USERNAME=
