# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Environment contract for the holons monorepo. ONE root .env serves every
# app and package (web, kiosk, wequest, telegram/discord bots, mcp-ui,
# scripts) — the SvelteKit apps set kit.env.dir / vite envDir to the repo
# root. Copy to `.env` and fill in. Grouped by who reads each variable.
#
# NEVER commit `.env`. If a secret leaks, ROTATE it — deleting the line is
# not enough (git history and bundles remember).
#
# Rule of thumb: VITE_* is inlined into browser bundles → public values only.

# ═══ Shared — every surface ═══════════════════════════════════════════════════
# Namespace the apps read/write. "Holons" is LIVE production data;
# "HolonsDebug" is the scratch namespace for development.
HOLONS_APP=HolonsDebug
# Nostr relays are the wire (comma-separated). Unset → the production relays,
# wss://relay.holons.io + wss://relay.commonshub.dev.
# HOLOSPHERE_RELAYS=
# VITE_HOLOSPHERE_RELAYS=
# Service signing key (`nsec1…`; 64-char hex accepted): bot, discord, mcp-ui
# and scripts sign every write with it. Never confuse with ETH_PRIVATE_KEY.
HOLOSPHERE_NSEC=
# Per-member Nostr key derivation (web login, bot RSVPs/profiles). LOAD-BEARING:
# changing it changes every member's pubkey.
NOSTR_DERIVATION_SECRET=
# Server-side OpenAI key: web/kiosk AI routes (task breakdown, voice relay) and
# the bot's AI features.
OPENAI=
# Standard-kind projections are ON for every lens by default: each write is
# also published as its standard Nostr kind (quests/events → NIP-52 31923,
# offers → NIP-99 30402, users → kind 0, checklists/shopping/library → NIP-51
# 30003, roles → NIP-58 badges, settings → NIP-29 group metadata), and external
# edits of those kinds are folded back (reverse sync). Uncomment to narrow or
# disable: off | comma list of lenses. Kind 0 / RSVPs also need
# NOSTR_DERIVATION_SECRET (bot).
# HOLOSPHERE_PROJECTIONS=off
# VITE_HOLOSPHERE_PROJECTIONS=off
# HOLOSPHERE_PROJECTIONS_SYNC=off
# VITE_HOLOSPHERE_PROJECTIONS_SYNC=off
# HOLOSPHERE_PROJECTIONS_LOOKBACK=7d

# ═══ Web apps — apps/web, apps/kiosk, apps/wequest ════════════════════════════
# -- Server functions (Telegram login → JWT session) --
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Session-JWT signing secret — generate a long random string.
AUTH_JWT_SECRET=
# Only needed when the callback origin differs from the serving origin.
TELEGRAM_OIDC_CALLBACK_ORIGIN=
# One-hop peer proxy for Telegram images when this deployment has no
# BOT_TOKEN (default: the production dashboard).
IMAGE_PROXY_URL=
# OpenCollective personal token, for the Flows board's read-only collective
# summary (/api/opencollective on both the kiosk and the dashboard). OPTIONAL:
# public collectives read fine anonymously; a token only raises the rate limit.
OPENCOLLECTIVE_TOKEN=

# -- Browser (public by design; these ship in the client bundle) --
# The PUBLIC half of HOLOSPHERE_NSEC (`npub1…` or hex): the web HNS registry
# holon id. Only public keys get a VITE_ prefix — never a secret.
VITE_HOLOSPHERE_NPUB=
# Bot HTTP API (message refresh + need DMs). Local bot: http://localhost:8080
VITE_BOT_API_URL=
# Base URL for generated QR codes (default: https://dashboard.holons.io/qr).
VITE_QR_BASE_URL=
# Publishable Mapbox client token; without it the map falls back to the SVG
# hex disk and the hex picker to manual entry.
VITE_MAPBOX_TOKEN=
# The hub's bot. The kiosk's "Start a holon" button deep-links to
# `t.me/<this>?startgroup=…` and the login widget uses it. Unset → HolonsBot.
VITE_TELEGRAM_BOT_USERNAME=HolonsBot
# Kiosk voice: ws = local @holons/voice-ui server; direct = browser→OpenAI
# (key from device Settings, else the /api/ai/voice relay with OPENAI above).
VITE_VOICE_MODE=ws
# Kiosk key-vault Telegram Mini App (t.me/<bot>/<short name>); pairs with
# MINIAPP_SHORT_NAME on the bot.
VITE_KIOSK_MINIAPP=
# WeQuest: default holon a fresh install lands in, namespace override, relays.
VITE_WEQUEST_HOLON=
VITE_WEQUEST_APP=
VITE_WEQUEST_RELAYS=

# -- Dev auto-login (never set in production; ignored in production builds) --
VITE_DEV_TELEGRAM_USER_ID=
VITE_DEV_TELEGRAM_USER_NAME=
VITE_DEV_TELEGRAM_USER_LAST_NAME=
VITE_DEV_TELEGRAM_USER_USERNAME=

# ═══ Telegram bot — packages/telegram-ui ══════════════════════════════════════
# From @BotFather. Never put this in a repo or client bundle. (The web/kiosk
# image routes also read it, server-side, to fetch Telegram photos.)
BOT_TOKEN=
# Short name of the key-vault Mini App registered in BotFather (answers /key).
MINIAPP_SHORT_NAME=
# Where the bot links back TO: `<this>/<holon id>` is a holon's dashboard /
# board. Unset → https://dashboard.holons.io and https://hubs.network.
DASHBOARD_ADDRESS=
KIOSK_ADDRESS=https://hubs.network
# Warm local store for the long-running bot (unset → ./holosphere-store).
# HOLOSPHERE_STORE_DIR=./holosphere-store

# Community shifts in the Elinor format (https://elinor.commonshub.dev/docs).
# Relay(s) holding kind-31923 occurrences / kind-31925 signups for this bot's
# chats. Falls back to HOLOSPHERE_RELAYS, then wss://relay.holons.io.
SHIFTS_RELAYS=wss://relay.holons.io
# Hex pubkey of the shift coordinator whose occurrences are trusted. Unset →
# any author is accepted (fine for dev, set it in production).
SHIFTS_COORDINATOR_PUBKEY=
# Kind-31926 identity attestations name participants (docs/shifts-elinor.md →
# Identity attestations). Honor-by-default; list provider pubkeys to ignore.
SHIFTS_IDENTITY_BLACKLIST=

# Ethereum contracts (bot wallet flows + apps/web/scripts/deploy.*). 0x-hex
# key — NOT a Nostr nsec.
ETH_NETWORK=sepolia
ETH_CHAIN_ID=11155111
ETH_RPC_URL=
ETH_PRIVATE_KEY=

# ═══ Discord bot — packages/discord-ui ════════════════════════════════════════
DISCORD_TOKEN=
DISCORD_APP_ID=

# ═══ Tooling — scripts/, packages/mcp-ui ══════════════════════════════════════
# Dedicated author for bulk imports (scripts/import-*, retract-*): revocable,
# never a person's key.
ATLAS_IMPORTER_NSEC=
# mcp-ui: persistent file store instead of memory (optional).
# HOLOSPHERE_STORE_DIR=./holosphere-store
