# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Environment contract for the holons monorepo. ONE root .env serves every
# app and package (web, kiosk, wequest, telegram bot) — the SvelteKit apps
# set kit.env.dir / vite envDir to the repo root. Copy to `.env` and fill in.
#
# NEVER commit `.env`. If a secret leaks, ROTATE it — deleting the line is
# not enough (git history and bundles remember).

# ── Holosphere ──────────────────────────────────────────────────────────────
# Namespace the apps read/write. "Holons" is LIVE production data;
# "HolonsDebug" is the scratch namespace for development.
HOLONS_APP=HolonsDebug

# ── Telegram bot (packages/telegram-ui) ─────────────────────────────────────
# From @BotFather. Never put this in a repo or client bundle.
BOT_TOKEN=

# Community shifts in the Elinor format (https://elinor.commonshub.dev/docs).
# Relay(s) holding kind-31923 occurrences / kind-31925 signups for this bot's
# chats. Falls back to HOLOSPHERE_RELAYS, then wss://relay.holons.io.
SHIFTS_RELAYS=wss://relay.holons.io
# Hex pubkey of the shift coordinator whose occurrences are trusted. Unset →
# any author is accepted (fine for dev, set it in production).
SHIFTS_COORDINATOR_PUBKEY=
# Signups are signed per member with NOSTR_DERIVATION_SECRET (below).
# Kind-31926 identity attestations name participants (docs/shifts-elinor.md →
# Identity attestations). Honor-by-default; list provider pubkeys to ignore.
SHIFTS_IDENTITY_BLACKLIST=

# Standard-kind projections: also publish listed lenses as their standard
# Nostr kind (quests/events → NIP-52 31923, offers → NIP-99 30402, users →
# kind 0, checklists/shopping/library → NIP-51 30003) next to the 30078
# record, so third-party clients can read them. off (default) | all | list.
# Needs HOLOSPHERE_RELAYS; kind 0 / RSVPs also need NOSTR_DERIVATION_SECRET.
# Lenses: quests,events,offers,users,checklists,shopping,library,roles (NIP-58
# badges),settings (NIP-29 group metadata). `users` also emits NIP-29 join/leave.
HOLOSPHERE_PROJECTIONS=off
VITE_HOLOSPHERE_PROJECTIONS=off
# Reverse sync: fold external edits of those standard kinds (by the holon key,
# a member's derived key or settings.nostrTrustedPubkeys) back into the
# records. Default on whenever projections are on. LOOKBACK bounds the
# cold-start catch-up (7d, 12h, 3600).
HOLOSPHERE_PROJECTIONS_SYNC=on
VITE_HOLOSPHERE_PROJECTIONS_SYNC=on
HOLOSPHERE_PROJECTIONS_LOOKBACK=7d

# ── Telegram OIDC login (web, kiosk, wequest server functions) ──────────────
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Session-JWT signing secret — generate a long random string.
AUTH_JWT_SECRET=
# Only needed when the callback origin differs from the serving origin.
TELEGRAM_OIDC_CALLBACK_ORIGIN=

# ── Web dashboard (apps/web) ────────────────────────────────────────────────
# Derives per-user Nostr keys from the Telegram identity — load-bearing,
# changing it changes every derived key.
NOSTR_DERIVATION_SECRET=
# Bot HTTP API (message refresh + need DMs). Local bot: http://localhost:8080
VITE_BOT_API_URL=
# One-hop peer proxy for Telegram images when this deployment has no
# BOT_TOKEN (default: the production dashboard).
IMAGE_PROXY_URL=

# ── WeQuest (apps/wequest) ──────────────────────────────────────────────────
# Default holon a fresh install lands in (Setup screen asks when empty).
VITE_WEQUEST_HOLON=
# Namespace override. Dev builds default to HolonsDebug, production builds
# to Holons — set explicitly to pin either.
VITE_WEQUEST_APP=
# Nostr relays, comma-separated (default: the production relays).
VITE_WEQUEST_RELAYS=
# Publishable Mapbox client token; without it the map falls back to the SVG
# hex disk and the hex picker to manual entry.
VITE_MAPBOX_TOKEN=

# OpenCollective personal token, for the Flows board's read-only collective
# summary (/api/opencollective on both the kiosk and the dashboard). OPTIONAL:
# public collectives read fine anonymously; a token only raises the rate limit.
# Server-side only — it must never reach a client bundle, which is why the
# apps proxy the GraphQL call instead of fetching it from the browser.
OPENCOLLECTIVE_TOKEN=

# ── Kiosk / hub boards (apps/kiosk) ─────────────────────────────────────────
# The hub's bot. The home page's "Start a holon" button deep-links to
# `t.me/<this>?startgroup=…`; public by design (it ships in the client bundle).
# Unset → HolonsBot.
VITE_TELEGRAM_BOT_USERNAME=HolonsBot
# Where the bot links back TO: `<this>/<holon id>` is a holon's own board, and
# a wildcard domain serves every holon from the one kiosk deploy. Read by the
# Telegram bot (server-side). Unset → https://hubs.network
KIOSK_ADDRESS=https://hubs.network

# ── Dev auto-login (never set in production) ────────────────────────────────
VITE_DEV_TELEGRAM_USER_ID=
VITE_DEV_TELEGRAM_NAME=
VITE_DEV_TELEGRAM_LAST_NAME=
VITE_DEV_TELEGRAM_USERNAME=
