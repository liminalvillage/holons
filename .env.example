APPNAME = "XXXXXXXXXXXXXXX"
TELEGRAM = "XXXXXXXXXXXXXXXXXXXXXXX"
# Telegram Bot Username for Login Widget (without @)
VITE_TELEGRAM_BOT_USERNAME = "HolonsBot"
# Dev-only Telegram user — auto-logs in as this user when running outside a real
# Telegram WebApp / Login Widget context. Active only when MODE !== 'production'.
VITE_DEV_TELEGRAM_USER_ID = ""
VITE_DEV_TELEGRAM_USER_NAME = ""
# Base URL for QR code generation
VITE_QR_BASE_URL = "https://dashboard.holons.io/qr"
# holonsbot HTTP API — when set, every holosphere.put fires a fire-and-forget
# /refresh/<kind> POST so the bot can bootstrap or refresh the Telegram message
# for the touched task/event/expense. Leave unset to disable.
# VITE_BOT_API_URL = "http://localhost:3101"
DISCORD = "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
MATTERMOST_URL = "https://chat.holochain.org"
MATTERMOST_TOKEN = ""
OPENAI = "XXXXXXXXXXXXXXXXXXXXXXXXX"
PREFIX = "/"

# Web3 Configuration - Used for contract deployment and transactions
# Private key for deploying contracts (npm run deploy)
WEB3KEY = ""
# RPC Provider URL
# WEB3PROVIDER = "https://sepolia.infura.io/v3/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# CHAINID = "11155111"
# NETWORK = "sepolia"
WEB3PROVIDER = "https://rpc.gnosischain.com/"
CHAINID = "100"
NETWORK = "gnosis"

MODE = "development"