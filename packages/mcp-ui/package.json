    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@holons/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "holosphere": "1.3.0-alpha4",
    "zod": "^3.23.8",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
