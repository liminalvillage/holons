{
  "name": "@holons/telegram-ui",
  "version": "2.0.0",
  "description": "Telegram UI for Holons. Calls into @holons/core for business logic.",
  "main": "src/HolonsBot.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "tsx src/HolonsBot.js",
    "dev": "tsx watch src/HolonsBot.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "nodemon --watch src --watch core --watch utils --ext js --exec 'npm run docs'"
  },
  "author": "Roberto Valenti",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@holons/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "dayjs": "^1.11.10",
    "debug": "^4.3.4",
    "discord.js": "^14.7.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.7.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "gun": "^0.2020.1239",
    "h3-js": "^4.1.0",
    "helmet": "^8.1.0",
    "holosphere": "1.3.0-alpha4",
    "http-proxy": "^1.18.1",
    "i18next": "^22.5.1",
    "i18next-fs-backend": "^2.6.0",
    "jsonschema": "^1.4.1",
    "julian": "^0.2.0",
    "lune": "^0.4.0",
    "moment": "^2.29.4",
    "node-schedule": "^2.1.1",
    "nostr-tools": "^2.17.2",
    "openai": "^4.104.0",
    "puppeteer": "^24.42.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "clean-jsdoc-theme": "^4.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdoc": "^4.0.5",
    "nodemon": "^3.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
