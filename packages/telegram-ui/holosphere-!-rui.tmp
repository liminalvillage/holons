k\",\"status\":\"ongoing\",\"category\":\"\",\"timeTracking\":{},\"checklistId\":\"968\",\"reminderId\":null,\"activeHolograms\":[],\"notes\":[{\"from\":{\"id\":6152474485,\"is_bot\":true,\"first_name\":\"Holons\",\"username\":\"HolonsBot\"},\"timestamp\":1750686204348}],\"description\":\"Inspired by https://t.co/7uBIjd0Rpg\"}",">":1774819323747}},"79":{"":{":":"{\"id\":979,\"version\":\"0.1\",\"chat\":-1002352632800,\"message_thread_id\":9,\"initiator\":{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"},\"title\":\"review offers and requests functionality on dashboard\",\"picture\":null,\"document\":\"\",\"where\":{\"latitude\":\"\",\"longitude\":\"\"},\"date\":1751114250155,\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"type\":\"task\",\"status\":\"ongoing\",\"category\":\"Dashboard Development\",\"timeTracking\":{},\"checklistId\":\"979\",\"reminderId\":null,\"activeHolograms\":[],\"description\":\"Pre-questions - \\n\\nDo we develop this further, or push ahead with Sarafu commitment pool implementation?\\n\\nThe dashboard knows what group I loaded the dashboard from - can it also know my user credentials?\\n\\nAs an accepter of an offer, after accepting the offer, the next steps need to be clear.\\nI would like a hologram sent to my personal holon, the personal holon of the person who made the offer, and an easy way in which we can be in touch to arrange the delivery of the goods / service, that ensures that my private data is protected. I would like there to be a record that I have accepted that offer, and that the offer had been completed in my personal records.\\n\\nAs the offerer, I would like to know when someone accepts an offer, and would like a way that I can contact them easily, ideally with one click opening a telegram chat referencing the offer. I would like there to be a record that the offer was completed, and that I had contributed to society in some way.\\n\\nAs a member of the holon in which the offer was made, I would like to see that the offer had been accepted and that the offer was closed, so that I am aware that the offer is no longer available.\\\\\"}",">":1751122632138}},"86":{"":{":":"{\"id\":986,\"version\":\"0.1\",\"chat\":-1002352632800,\"message_thread_id\":8,\"initiator\":{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"},\"title\":\"review language glitch on subtasks menu on /task\",\"picture\":null,\"document\":\"\",\"where\":{\"latitude\":\"\",\"longitude\":\"\"},\"date\":1751114370383,\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"type\":\"task\",\"status\":\"ongoing\",\"category\":\"Bot Development\",\"timeTracking\":{},\"checklistId\":null,\"reminderId\":null,\"activeHolograms\":[]}",">":1751114371427}},"91":{"":{":":"{\"id\":\"991\",\"version\":\"0.1\",\"chat\":-1002352632800,\"message_thread_id\":8,\"initiator\":{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"},\"title\":\"change all comma separated logic to semi-colon (;) separated on lists and checklists to avoid user confusion.\",\"picture\":null,\"document\":\"\",\"where\":{\"latitude\":\"\",\"longitude\":\"\"},\"date\":1751114555032,\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"type\":\"task\",\"status\":\"ongoing\",\"category\":\"Bot Development\",\"timeTracking\":{},\"checklistId\":null,\"reminderId\":null,\"activeHolograms\":[],\"position\":{\"x\":13.621474348559104,\"y\":-2586.6217254944777}}",">":1751720269195}}}}},"49080190