essage_thread_id\":8,\"initiator\":{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"},\"title\":\"fix holograms so that initiation of task does not create holon in me holon.\",\"picture\":null,\"document\":\"\",\"where\":{\"latitude\":\"\",\"longitude\":\"\"},\"date\":1749030676125,\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[{\"id\":235114395,\"firstName\":\"Roberto\",\"lastName\":\"Valenti | Liminal Village\",\"username\":\"RobertoValenti\"}],\"appreciation\":[{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"}],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"type\":\"task\",\"status\":\"completed\",\"category\":\"Bot Development\",\"timeTracking\":{},\"checklistId\":null,\"reminderId\":null,\"activeHolograms\":[{\"platform\":\"telegram\",\"chatId\":\"1971913512\",\"messageId\":17548},{\"platform\":\"telegram\",\"chatId\":-1002352632800,\"messageId\":899}],\"completed_at\":\"2025-06-13T16:08:00.990Z\"}",">":1749830880992}}},"9":{"":{":":"{\"id\":979,\"version\":\"0.1\",\"chat\":-1002352632800,\"message_thread_id\":9,\"initiator\":{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"},\"title\":\"review offers and requests functionality on dashboard\",\"picture\":null,\"document\":\"\",\"where\":{\"latitude\":\"\",\"longitude\":\"\"},\"date\":1751114250155,\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"type\":\"task\",\"status\":\"ongoing\",\"category\":\"Dashboard Development\",\"timeTracking\":{},\"checklistId\":\"979\",\"reminderId\":null,\"activeHolograms\":[],\"description\":\"Pre-questions - \\n\\nDo we develop this further, or push ahead with Sarafu commitment pool implementation?\\n\\nThe dashboard knows what group I loaded the dashboard from - can it also know my user credentials?\\n\\nAs an accepter of an offer, after accepting the offer, the next steps need to be clear.\\nI would like a hologram sent to my personal holon, the personal holon of the person who made the offer, and an easy way in which we can be in touch to arrange the delivery of the goods / service, that ensures that my private data is protected. I would like there to be a record that I have accepted that offer, and that the offer had been completed in my personal records.\\n\\nAs the offerer, I would like to know when someone accepts an offer, and would like a way that I can contact them easily, ideally with one click opening a telegram chat referencing the offer. I would like there to be a record that the offer was completed, and that I had contributed to society in some way.\\n\\nAs a member of the holon in which the offer was made, I would like to see that the offer had been accepted and that the offer was closed, so that I am aware that the offer is no longer available.\\\\\"}",">":1751122632138}},"":{":":"{\"id\":742,\"version\":\"0.1\",\"chat\":-1002352632800,\"message_thread_id\":8,\"initiator\":{\"id\":1971913512,\"is_bot\":false,\"first_name\":\"Simon\",\"last_name\":\"Q\",\"username\":\"qbfrank\",\"language_code\":\"en\"},\"title\":\"ensure that we cannot validate our own task completion (once changed from \\\"appreciate\\\"\",\"picture\":null,\"document\":\"\",\"where\":{\"latitude\":\"\",\"longitude\":\"\"},\"date\":1748963113434,\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"type\":\"task\",\"status\":\"ongoing\",\"category\":\"Bot Development\",\"timeTracking\":{},\"checklistId\":null,\"reminderId\":null,\"activeHolograms\":[{\"platform\":\"telegram\",\"chatId\":\"1971913512\",\"messageId\":17521}]}",">":17