28-500x99999.jpg\",\"document\":\"\",\"type\":\"task\",\"status\":\"ongoing\",\"date\":1774566114741,\"where\":{\"latitude\":\"42.8802\",\"longitude\":\"13.8169\"},\"when\":\"April 2026\",\"until\":\"August 2026\",\"completed\":\"\",\"participants\":[{\"name\":\"Anonymous\",\"date\":1774638529143}],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"timeTracking\":{},\"checklistId\":null,\"reminderId\":null,\"activeHolograms\":[],\"category\":\"circular-economy\"}",">":1774638529373}},"promozione-buone-pratiche":{"":{":":"{\"id\":\"promozione-buone-pratiche\",\"version\":\"0.1\",\"chat\":\"235114395\",\"message_thread_id\":null,\"initiator\":\"liminalvillage\",\"title\":\"Promozione e scambio buone pratiche\",\"description\":\"Documenting activities, systematizing good practices, and supporting their dissemination. Covers content production, communication support, and result-sharing activities within the network and externally.\",\"picture\":\"/images/P1120415-500x99999.jpeg\",\"document\":\"\",\"type\":\"task\",\"status\":\"ongoing\",\"date\":1774566114741,\"where\":{\"latitude\":\"42.8802\",\"longitude\":\"13.8169\"},\"when\":\"\",\"until\":\"\",\"completed\":\"\",\"participants\":[{\"name\":\"Anonymous\",\"date\":1774653744914}],\"appreciation\":[],\"stoppers\":[],\"dependencies\":[],\"frequency\":null,\"recurringTaskId\":null,\"timeTracking\":{},\"checklistId\":null,\"reminderId\":null,\"activeHolograms\":[],\"category\":\"communication\"}",">":1774653745356}},"task_1734257":{"2":{"15454_p6k271eg7":{"":{":":null,">":1750112074142}},"93733_tbx573dgv":{"":{":":null,">":1760221799485.004}}},"324582_p3hw0i3re":{"":{":":null,">":1760221799505.007}}}},"settings\u001b":{"235114395":{"":{":":"{\"id\":235114395,\"hex\":\"\",\"version\":0.1,\"name\":\"Roberto Valenti | Liminal Village\",\"timezone\":\"\",\"whitelisted\":false,\"language\":\"en\",\"theme\":\"dark\",\"level\":0,\"admin\":\"\",\"roles\":[],\"values\":[],\"pur