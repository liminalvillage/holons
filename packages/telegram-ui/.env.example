# ===========================================
# HolonsBot Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# Core Bot Tokens (Required)
# -------------------------------------------
TELEGRAM=your_telegram_bot_token_here
DISCORD=your_discord_bot_token_here
MATTERMOST=your_mattermost_token_here

# Legacy token names (alternative)
BOT_TOKEN=your_telegram_bot_token_here
DISCORD_TOKEN=your_discord_bot_token_here

# -------------------------------------------
# Application Settings
# -------------------------------------------
APPNAME=Holons
NODE_ENV=development
MODE=development
PREFIX=/
LANGUAGE=en

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=8080
SSL_KEY_PATH=certs/private.key
SSL_CERT_PATH=certs/certificate.crt

# -------------------------------------------
# Dashboard & Web App (Required for inline buttons)
# Must be HTTPS for Telegram inline keyboard buttons
# Default: https://dashboard.holons.io
# -------------------------------------------
DASHBOARD_ADDRESS=https://dashboard.holons.io

# -------------------------------------------
# Gun.js / HoloSphere Configuration
# -------------------------------------------
GUN_PORT=8765
GUN_PEERS=https://peer1.example.com/gun,https://peer2.example.com/gun
HOLOSPHERE_PRIVATE_KEY=your_holosphere_private_key
HOLOSPHERE_USER=your_holosphere_username
HOLOSPHERE_PASS=your_holosphere_password

# -------------------------------------------
# Proxy Server (if using proxy.js)
# -------------------------------------------
PROXY_PORT=443
AVATAR_SERVER_URL=http://localhost:3000
GUN_SERVER_URL=http://localhost:8765

# -------------------------------------------
# Web3 / Blockchain Configuration
# -------------------------------------------
NETWORK=mainnet
CHAINID=1
WEB3KEY=your_wallet_private_key
WEB3PROVIDER=https://mainnet.infura.io/v3/your_project_id

# For testing
RPC_URL=https://your-rpc-url
PRIVATE_KEY=your_test_private_key
HOLONS_CONTRACT=0x_your_contract_address
ALICE_WALLET=0x_alice_wallet_address
BOB_WALLET=0x_bob_wallet_address

# -------------------------------------------
# AI Integration
# -------------------------------------------
OPENAI=your_openai_api_key_here

# -------------------------------------------
# Quest Display Options
# -------------------------------------------
SHOW_QUESTS_AS_IMAGES=true
QUEST_IMAGE_FAST_MODE=true

# -------------------------------------------
# Logging & Debugging
# -------------------------------------------
LOG_LEVEL=info
SIGNAL_DEBUG=false
I18N_DEBUG=false

# -------------------------------------------
# Timeouts (in milliseconds)
# -------------------------------------------
BOT_TIMEOUT=30000
DB_TIMEOUT=10000
API_TIMEOUT=15000

# -------------------------------------------
# Admin Configuration
# -------------------------------------------
ADMIN_IDS=123456789,987654321
ADMIN_CHAT_ID=-1001234567890
SIGNAL_ALERT_ADMIN=true
