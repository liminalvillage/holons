{
  "name": "@holons/discord-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Discord UI for Holons. Slash-command bot that calls into @holons/core for business logic.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/runtime/registerCommands.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Roberto Valenti",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@holons/core": "workspace:*",
    "discord.js": "^14.16.3",
    "dotenv": "^17.2.3",
    "holosphere": "workspace:*",
    "nostr-tools": "^2.17.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.17",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
}
