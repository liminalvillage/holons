{
  "title": "quests",
  "description": "Records stored at (holonId, 'quests', <id>). Holds Quest, Event, recurring-task, and marketplace offer/request/need records — they share this lens.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier. Telegram writes numeric ids stringified upstream."
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Discriminator (task / quest / event / recurring / offer / request / need). offer|request|need mark marketplace items."
    },
    "status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "participants": {
      "type": "array"
    },
    "appreciation": {
      "type": "array"
    },
    "category": {
      "type": "string"
    },
    "when": {
      "type": "string",
      "format": "date-time"
    },
    "ends": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "initiator": {
      "type": "object"
    },
    "orderIndex": {
      "type": "number"
    },
    "dependsOn": {
      "type": "array"
    },
    "canvasId": {
      "type": "string"
    },
    "_meta": {
      "type": "object"
    },
    "_deleted": {
      "type": "boolean"
    },
    "_hologram": {
      "type": "object"
    },
    "_federation": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "status"
  ]
}
