{
  "title": "quests",
  "description": "Records stored at (holonId, 'quests', <id>). Holds Quest, Event, recurring-task, and Proposal records \u2014 they share this lens. Proposals have type: 'proposal'; everything else is some flavour of Quest.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier. Telegram writes numeric ids stringified upstream."
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Discriminator. 'proposal' selects the council branch; everything else is a quest/event/recurring."
    },
    "status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "participants": {
      "type": "array"
    },
    "stoppers": {
      "type": "array",
      "description": "Proposal vetoes (only on proposal records)."
    },
    "appreciation": {
      "type": "array"
    },
    "category": {
      "type": "string"
    },
    "when": {
      "type": "string",
      "format": "date-time"
    },
    "ends": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "initiator": {
      "type": "object"
    },
    "orderIndex": {
      "type": "number"
    },
    "dependsOn": {
      "type": "array"
    },
    "canvasId": {
      "type": "string"
    },
    "_meta": {
      "type": "object"
    },
    "_deleted": {
      "type": "boolean"
    },
    "_hologram": {
      "type": "object"
    },
    "_federation": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "type"
  ],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "proposal"
        }
      },
      "required": [
        "participants",
        "stoppers"
      ]
    },
    {
      "properties": {
        "type": {
          "not": {
            "const": "proposal"
          }
        }
      },
      "required": [
        "status"
      ]
    }
  ]
}
