{
  "title": "advisor_library",
  "description": "Records stored at (holonId, 'advisor_library', <id>). Council/ritual advisor profiles. `type` selects the characterSpec shape.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "archetype | real | mythic"
    },
    "lens": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string",
      "format": "uri"
    },
    "creatorUserId": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "characterSpec": {
      "type": "object",
      "description": "Shape varies by type. archetype: background + purpose. real: background_context + known_for. mythic: mythic_domain + cultural_origin."
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "lens",
    "characterSpec"
  ],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "archetype"
        },
        "characterSpec": {
          "type": "object",
          "required": [
            "background",
            "purpose"
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "real"
        },
        "characterSpec": {
          "type": "object",
          "required": [
            "background_context",
            "known_for"
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "mythic"
        },
        "characterSpec": {
          "type": "object",
          "required": [
            "mythic_domain",
            "cultural_origin"
          ]
        }
      }
    }
  ]
}
