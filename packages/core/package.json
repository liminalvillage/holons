{
  "name": "@holons/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain logic for Holons UIs (web, telegram, text, ai). UI-agnostic.",
  "exports": {
    ".": "./src/index.ts",
    "./expenses": {
      "types": "./dist/expenses/index.d.ts",
      "import": "./dist/expenses/index.js",
      "default": "./dist/expenses/index.js"
    },
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "holosphere": "1.3.0-alpha4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
