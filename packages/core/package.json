{
  "name": "@holons/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain logic for Holons UIs (web, telegram, text, ai). UI-agnostic.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "node": "./dist/*/index.js",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "holosphere": "1.3.0-alpha4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
