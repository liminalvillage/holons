{
  "name": "@holons/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain logic for Holons UIs (web, telegram, text, ai). UI-agnostic.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*",
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./dist/*/index.js",
      "default": "./src/*/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": ["./src/*/index.ts"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src",
    "seed:kml-projects": "node scripts/seed-kml-projects.mjs",
    "seed:demo-holon": "node scripts/seed-demo-holon.mjs"
  },
  "dependencies": {
    "holosphere": "1.3.0-alpha8",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "eslint": "^9.35.0",
    "h3-js": "^4.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.18"
  }
}
