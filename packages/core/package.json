{
  "name": "@holons/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain logic for Holons UIs (web, telegram, text, ai). UI-agnostic.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./src/index.ts",
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./dist/*/index.js",
      "default": "./src/*/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": ["./src/*/index.ts"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "holosphere": "1.3.0-alpha5",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
