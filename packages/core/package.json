{
  "name": "@holons/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain logic for Holons UIs (web, telegram, text, ai). UI-agnostic.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "default": "./dist/settings/index.js"
    },
    "./scoring": {
      "types": "./dist/scoring/index.d.ts",
      "import": "./dist/scoring/index.js",
      "default": "./dist/scoring/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "settings": ["./dist/settings/index.d.ts"],
      "scoring": ["./dist/scoring/index.d.ts"],
      "*": ["./dist/*/index.d.ts"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "holosphere": "1.3.0-alpha4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
