# ── Provider selection ────────────────────────────────────────────────
# Master switch for all three legs. Per-leg overrides win when set.
VOICE_PROVIDER=api            # api | local   (default: api)
# LLM_PROVIDER=api
# STT_PROVIDER=api
# TTS_PROVIDER=api

VOICE_PORT=8787

# ── API leg ───────────────────────────────────────────────────────────
# LLM = Claude (reuses ai-ui's provider); STT/TTS = OpenAI.
ANTHROPIC_API_KEY=
HOLONS_AI_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
# STT_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# ── Local leg (VOICE_PROVIDER=local) ──────────────────────────────────
# LLM via an OpenAI-compatible server (e.g. mlx_lm.server).
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=local
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit
# STT_MODEL=base.en                                  # whisper.cpp model
# TTS_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX      # kokoro-js model
# TTS_VOICE=af_heart
# Local providers are optional deps — install to use:
#   pnpm --filter @holons/voice-ui add nodejs-whisper kokoro-js

# ── Holons MCP server (stdio) ─────────────────────────────────────────
# Defaults to launching packages/mcp-ui/dist/index.js with `node`.
# HOLONS_MCP_COMMAND=node
# HOLONS_MCP_ARGS=/abs/path/to/packages/mcp-ui/dist/index.js
HOLONS_ACTOR_ID=
HOLONS_ACTOR_NAME=
HOLONS_ACTOR_USERNAME=

# Optional: override the spoken-agent system prompt.
# VOICE_SYSTEM_PROMPT=
