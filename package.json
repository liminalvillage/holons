{
	"name": "holons-monorepo",
	"version": "0.1.0",
	"private": true,
	"author": {
		"name": "Roberto Valenti"
	},
	"license": "AGPL-3.0-or-later",
	"description": "Holons monorepo: shared core domain logic + web, telegram, text, and AI UIs.",
	"type": "module",
	"scripts": {
		"dev": "pnpm -F harvest-web dev",
		"dev:bot": "pnpm -F @holons/telegram-ui dev",
		"dev:discord": "pnpm -F @holons/discord-ui dev",
		"dev:kiosk": "pnpm -F kiosk dev",
		"build": "pnpm -r --if-present build",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present test",
		"lint": "pnpm -r --if-present lint",
		"format": "pnpm -r --if-present format",
		"clean": "pnpm -r --if-present clean && rm -rf node_modules"
	},
	"devDependencies": {
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=20",
		"pnpm": ">=10"
	}
}
