{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role Schema",
  "description": "Schema for role objects in HolonsBot",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the role"
    },
    "title": {
      "type": "string",
      "description": "Role title"
    },
    "description": {
      "type": "string",
      "description": "Role description"
    },
    "created": {
      "type": "string",
      "description": "Creation timestamp",
      "format": "date-time"
    },
    "creator": {
      "type": "string",
      "description": "Username of role creator"
    },
    "members": {
      "type": "array",
      "description": "Users assigned to this role",
      "items": {
        "type": ["string", "number"]
      },
      "default": []
    },
    "permissions": {
      "type": "array",
      "description": "Permissions granted by this role",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "responsibilities": {
      "type": "array",
      "description": "Role responsibilities",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "checklistId": {
      "type": "string",
      "description": "Associated checklist ID"
    },
    "active": {
      "type": "boolean",
      "description": "Whether role is active",
      "default": true
    },
    "color": {
      "type": "string",
      "description": "Role color for display"
    },
    "icon": {
      "type": "string",
      "description": "Role icon/emoji"
    }
  },
  "required": [
    "id",
    "title",
    "created",
    "creator"
  ],
  "additionalProperties": false
}