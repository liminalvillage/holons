{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checklist Schema",
  "description": "Schema for checklist objects in HolonsBot",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the checklist"
    },
    "type": {
      "type": "string",
      "description": "Type of checklist",
      "enum": ["checklist", "agenda", "shopping", "quest", "role"]
    },
    "items": {
      "type": "array",
      "description": "Checklist items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item identifier"
          },
          "text": {
            "type": "string",
            "description": "Item text"
          },
          "done": {
            "type": "boolean",
            "description": "Whether item is completed",
            "default": false
          },
          "priority": {
            "type": "string",
            "description": "Item priority",
            "enum": ["low", "medium", "high"]
          }
        },
        "required": ["id", "text", "done"],
        "additionalProperties": false
      },
      "default": []
    },
    "created": {
      "type": "string",
      "description": "Creation timestamp",
      "format": "date-time"
    },
    "creator": {
      "type": ["string", "null"],
      "description": "Username of creator"
    },
    "questId": {
      "type": "string",
      "description": "Associated quest ID (for quest checklists)"
    },
    "roleId": {
      "type": "string",
      "description": "Associated role ID (for role checklists)"
    },
    "parentTitle": {
      "type": "string",
      "description": "Title of parent quest/role"
    },
    "holonId": {
      "type": ["string", "number"],
      "description": "Chat ID where checklist belongs"
    }
  },
  "required": [
    "id",
    "type",
    "items",
    "created"
  ],
  "additionalProperties": false
}