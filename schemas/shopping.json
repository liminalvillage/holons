{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shopping Item Schema",
  "description": "Schema for shopping list items in HolonsBot",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Item name/identifier"
    },
    "done": {
      "type": "boolean",
      "description": "Whether the item has been bought",
      "default": false
    },
    "from": {
      "type": "string",
      "description": "Username of who added the item"
    },
    "date": {
      "type": "number",
      "description": "Timestamp when item was added"
    },
    "category": {
      "type": "string",
      "description": "Item category"
    },
    "priority": {
      "type": "string",
      "description": "Item priority",
      "enum": ["low", "medium", "high"]
    },
    "quantity": {
      "type": "number",
      "description": "Quantity needed",
      "minimum": 1,
      "default": 1
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the item"
    }
  },
  "required": [
    "id",
    "done",
    "from"
  ],
  "additionalProperties": false
}