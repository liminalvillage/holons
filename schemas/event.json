{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Schema",
  "description": "Schema for event objects in HolonsBot (extends quest schema)",
  "type": "object",
  "allOf": [
    {
      "$ref": "./quest.json"
    },
    {
      "properties": {
        "startDate": {
          "type": "string",
          "description": "Event start date/time",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "Event end date/time",
          "format": "date-time"
        },
        "duration": {
          "type": "number",
          "description": "Duration in minutes"
        },
        "recurring": {
          "type": "object",
          "description": "Recurring event settings",
          "properties": {
            "frequency": {
              "type": "string",
              "enum": ["daily", "weekly", "monthly", "yearly"]
            },
            "interval": {
              "type": "number",
              "minimum": 1,
              "default": 1
            },
            "endAfter": {
              "type": "number",
              "description": "Number of occurrences"
            },
            "endDate": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "maxParticipants": {
          "type": "number",
          "description": "Maximum number of participants"
        },
        "registrationRequired": {
          "type": "boolean",
          "description": "Whether registration is required",
          "default": false
        },
        "registeredParticipants": {
          "type": "array",
          "description": "List of registered participants",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "waitingList": {
          "type": "array",
          "description": "Waiting list for the event",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "description": "Event tags",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  ]
}