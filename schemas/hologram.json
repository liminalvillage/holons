{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hologram Schema",
  "description": "Schema for hologram objects (live-updating message references) in HolonsBot",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the hologram"
    },
    "sourceQuestId": {
      "type": "string",
      "description": "ID of the source quest"
    },
    "sourceholonId": {
      "type": ["string", "number"],
      "description": "Chat ID where the original quest exists"
    },
    "targetholonId": {
      "type": ["string", "number"],
      "description": "Chat ID where the hologram is displayed"
    },
    "targetMessageId": {
      "type": "number",
      "description": "Message ID of the hologram in target chat"
    },
    "userId": {
      "type": ["string", "number"],
      "description": "User ID for personal holograms"
    },
    "type": {
      "type": "string",
      "description": "Type of hologram",
      "enum": ["telegram", "personal", "federated"]
    },
    "created": {
      "type": "string",
      "description": "Creation timestamp",
      "format": "date-time"
    },
    "lastUpdated": {
      "type": "string",
      "description": "Last update timestamp",
      "format": "date-time"
    },
    "active": {
      "type": "boolean",
      "description": "Whether hologram is active",
      "default": true
    },
    "syncStatus": {
      "type": "string",
      "description": "Synchronization status",
      "enum": ["synced", "pending", "error"],
      "default": "synced"
    },
    "errorCount": {
      "type": "number",
      "description": "Number of sync errors",
      "minimum": 0,
      "default": 0
    },
    "lastError": {
      "type": "string",
      "description": "Last error message"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "additionalProperties": true,
      "default": {}
    }
  },
  "required": [
    "id",
    "sourceQuestId",
    "sourceholonId",
    "type",
    "created"
  ],
  "additionalProperties": false
}