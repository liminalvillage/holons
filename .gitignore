# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules
/package
.package-lock.json
# NOTE: pnpm-lock.yaml IS committed — it pins the whole workspace for
# reproducible installs and CI. Do not add it back here.

# ── Build output ──────────────────────────────────────────────────────────
build/
dist/
.svelte-kit/
.netlify/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
yarn-error.log

# ── Secrets & per-developer config (NEVER commit) ─────────────────────────
.env
.env.*
!.env.example
# Per-developer Claude Code MCP wiring (contains actor-id env defaults).
.mcp.json
# Local Claude Code / agent state.
.claude/
.superpowers/
# Executed/signed legal originals (contain signatures, addresses, tax codes).
# Only the unexecuted templates in legal/ are tracked.
legal/executed/
legal/**/*.signed.*
legal/**/*.pdf
# Private IP / legal working material — never commit or push.
/ip/

# ── Gun.js / Holosphere local replica (regenerated at runtime) ────────────
radata*
radata/*
holosphere.db/*
# Gun/radata junk dirs named "holosphere" written to each app's CWD at runtime.
holosphere/
# …but NOT the vendored package or the source dirs of the same name.
!packages/holosphere/
!packages/core/src/holosphere/
!apps/web/src/lib/holosphere/
# Gun RAD temp files written to CWD (e.g. holosphere-!-xyz.tmp)
holosphere-!-*
holosphere-*
# ── Generated API docs ────────────────────────────────────────────────────
docs/api/*
